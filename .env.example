# ============================ TRAVLR ======================================
# --- Pflicht ---------------------------------------------------------------
# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Login der App (zweite Stufe hinter Cloudflare Access). Ohne Passwort ist die App offen!
APP_USERNAME=admin
APP_PASSWORD=

# --- Flugquellen (mind. eine; ohne beide läuft der Demo-Modus mit Beispieldaten) ---
# Google Flights + Deal-Radar (Travel Explore) über SerpApi (https://serpapi.com/)
SERPAPI_API_KEY=
# Duffel (https://duffel.com/): direkt buchbare Airline-Tarife, Suche kostenlos
DUFFEL_API_KEY=
# seats.aero Pro-API-Key für Prämienflug-Verfügbarkeit (optional)
SEATS_AERO_API_KEY=

# --- Push-Benachrichtigungen (ntfy) ----------------------------------------
# Öffentlicher Server oder eigener (z. B. ntfy-Container auf der Synology)
NTFY_URL=https://ntfy.sh
# Themenname: wie ein Passwort behandeln, wenn du ntfy.sh ohne Login nutzt (lang und zufällig)
NTFY_TOPIC=
# Access-Token, falls dein ntfy-Server Login verlangt
NTFY_TOKEN=

# --- Cloudflare Access (optional, empfohlen) -------------------------------
# Wenn beide gesetzt sind, lässt TRAVLR nur Anfragen mit gültigem Access-Token durch.
# Team-Domain, z. B. deinteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" der Access-Anwendung
CF_ACCESS_AUD=

# --- Cloudflare Tunnel (eigener cloudflared-Container) ---------------------
# Token aus Zero Trust → Networks → Tunnels → Docker-Befehl (Teil nach --token)
CLOUDFLARE_TUNNEL_TOKEN=
# "tunnel" startet den cloudflared-Container mit; leer lassen für lokale Entwicklung
COMPOSE_PROFILES=

# --- Optional --------------------------------------------------------------
# Signierschlüssel für Login-Cookies; leer = wird einmalig erzeugt und in data/ gespeichert
SESSION_SECRET=
# Benutzer/Gruppe des Containers (Synology: per SSH `id`, oft 1026 / 100)
PUID=1000
PGID=1000
# Öffentliche Adresse (für das Homescreen-Manifest), z. B. https://travlr.example.com
PUBLIC_URL=
# Standard-Abflughafen, solange im Profil kein Wohnort steht
HOME_AIRPORTS=FRA
CURRENCY=EUR
# Obergrenze an Flugsuchen pro Agenten-Anfrage (schont das SerpApi-Kontingent)
MAX_SEARCHES=10
# Suchergebnisse so lange zwischenspeichern
CACHE_TTL_HOURS=6
# Preisalarme und Wochen-Digest im Hintergrund ausführen
SCHEDULER_ENABLED=true
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium
